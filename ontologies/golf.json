{
  "ontology_id": "golf.v1",
  "label": "高尔夫服务 Ontology",
  "schema_version": "1.4.0",
  "binding_version": "1.4.0",
  "arrival_process": {
    "id": "player_reception",
    "stages": [
      {"id":"met","label":"机场会合","action":"ConfirmAirportMeet","responsible":"greeter"},
      {"id":"boarded","label":"确认登车","action":"ConfirmBoarding","responsible":"driver"},
      {"id":"hotel_handoff","label":"酒店交接","action":"ConfirmHotelHandoff","responsible":"driver"},
      {"id":"checked_in","label":"确认入住","action":"ConfirmHotelCheckIn","responsible":"driver","requires_hotel_confirmation":true}
    ],
    "actions": [
      {"id":"ArrangePlayerReception","responsible":"dispatcher"},
      {"id":"ConfirmHotelReservation","responsible":"dispatcher"},
      {"id":"UpdatePlayerPhoto","responsible":"dispatcher"},
      {"id":"ReschedulePickup","responsible":"dispatcher","requires_agent_proposal":true},
      {"id":"AssignVehicle","responsible":"dispatcher"},
      {"id":"AcknowledgeArrivalNotice","responsible":"assigned_staff"},
      {"id":"FlagReceptionException","responsible":"assigned_staff"}
    ],
    "interfaces": [
      {"id":"ArrivalWatch","status_source":"HKIA","binding":"pickup_flight_links"},
      {"id":"ReceptionWorkItem","binding":"TransferLeg","player_progress":"PlayerReception"}
    ],
    "events": [
      {"id":"FlightArrived","source":"HKIA","binding":"arrival_runtime_events","version":1}
    ],
    "queries": [
      {"id":"ReadArrivalFlightStatus","source":"HKIA","binding":"GET /api/events/{event_id}/flight-arrivals/{flight}"},
      {"id":"EstimateGroundTransfer","source":"GoogleMaps","binding":"POST /api/events/{event_id}/arrival-plans/{plan_id}/route-estimate"}
    ],
    "handoffs": [
      {"id":"OpenGoogleMapsDirections","source":"GoogleMaps","binding":"travel_links.google_directions"},
      {"id":"OpenUberRide","source":"Uber","binding":"travel_links.uber","confirmation":"rider_in_uber"}
    ],
    "automations": [
      {"id":"NotifyFlightArrival","states":["landed","at_gate"],"event":"FlightArrived","effect":"Notify current greeter and driver and show receipts in the dispatch desk"},
      {"id":"TrackArrival","trigger":"HKIA scheduled, estimated, delayed, landed, at_gate, cancelled","effect":"Track flight and notify assigned team"},
      {"id":"EstimateMeetingWindow","trigger":"HKIA arrival time","effect":"Project earliest and latest airport meeting time"},
      {"id":"FlagHotelLateArrival","trigger":"Projected hotel arrival crosses confirmed cutoff","effect":"Notify dispatcher to confirm room hold"},
      {"id":"ProposePickupAdjustment","trigger":"Fresh HKIA delay evidence","effect":"Propose pickup time or available replacement vehicle for dispatcher confirmation"}
    ]
  },
  "arrival_rules": {"taxi_minutes": 10, "exit_min_minutes": 35, "exit_max_minutes": 65, "fresh_minutes": 10},
  "relationships": [
    {"id":"reception_for","from":"ArrivalPlan","to":"TransferLeg","cardinality":"1","binding":"arrival_plans.task_id"},
    {"id":"receives_players","from":"ArrivalPlan","to":"Player","cardinality":"1..12","binding":"arrival_plans.players"},
    {"id":"player_progress","from":"ArrivalPlan","to":"PlayerReception","cardinality":"1..12","binding":"arrival_plans.player_progress"},
    {"id":"confirmed_arrival","from":"ArrivalFlight","to":"FlightArrived","cardinality":"0..1 per activity","binding":"arrival_runtime_events"},
    {"id":"stays_at","from":"ArrivalPlan","to":"HotelStay","cardinality":"1","binding":"arrival_plans.hotel"},
    {"id":"greeted_by","from":"ArrivalPlan","to":"Greeter","cardinality":"1","binding":"arrival_plans.greeter"},
    {"id":"identified_by","from":"Player","to":"PlayerPhoto","cardinality":"0..1","binding":"arrival_photos.player_id"},
    {"id":"tracks_arrival","from":"TransferLeg","to":"ArrivalFlight","cardinality":"0..1","binding":"pickup_flight_links"},
    {"id":"handled_by","from":"TransferLeg","to":"Dispatcher","cardinality":"0..1","binding":"pickup_flight_links.dispatcher_id"},
    {"id":"driven_by","from":"TransferLeg","to":"Driver","cardinality":"1","binding":"assigned_driver"},
    {"id":"uses_vehicle","from":"TransferLeg","to":"Vehicle","cardinality":"1","binding":"vehicle_id"}
  ],
  "binding": {
    "task_type": "TransferLeg", "resource_type": "Vehicle",
    "title": "title", "description": "route", "subject": "player_name",
    "owner": "assigned_driver", "status": "dispatch_state", "resource": "vehicle_id",
    "progress": "service_facts", "required_capacity": "passengers",
    "resource_label": "callsign", "resource_capacity": "seats", "resource_ready": "readiness",
    "ready_value": "available", "initial_status": "assigned", "acknowledged_status": "acknowledged",
    "status_labels": {"assigned": "待接单", "acknowledged": "已接单"},
    "replace_label": "重新指派车辆", "domain_replace_action": "AssignVehicle",
    "pickup_time": "pickup_at", "domain_reschedule_action": "ReschedulePickup",
    "acknowledge_label": "确认接单", "domain_acknowledge_action": "AcceptTransfer",
    "field_response_milestones": ["出发", "到场", "交接"],
    "domain_confirm_progress_action": "ConfirmTransferMilestone"
  },
  "events": [{
    "id": "golf-demo", "title": "Golf Invitational · 演示活动",
    "objects": [
      {"object_type": "TransferLeg", "id": "transfer-001", "data": {"title": "接机 · 陈宇 / 林悦", "route": "机场 T2 → 湖畔饭店；当前仅演示调度，不代表真实车辆运行。", "player_name": "陈宇、林悦（合成资料）", "assigned_driver": "demo-staff", "dispatch_state": "assigned", "vehicle_id": "car-02", "passengers": 2, "service_facts": [{"label":"航班抵达","status":"done"},{"label":"机场会合","status":"current"},{"label":"登车确认","status":"pending"},{"label":"饭店交接","status":"pending"},{"label":"入住完成","status":"pending"}]}},
      {"object_type": "TransferLeg", "id": "transfer-002", "data": {"title": "球场接送 · 练习组", "route": "湖畔饭店 → 练习球场", "player_name": "练习组（合成资料）", "assigned_driver": "demo-other", "dispatch_state": "assigned", "vehicle_id": "car-05", "passengers": 3, "service_facts": [{"label":"集合确认","status":"current"},{"label":"登车确认","status":"pending"},{"label":"球场交接","status":"pending"}]}},
      {"object_type": "Vehicle", "id": "car-02", "data": {"callsign":"02 号接驳车", "seats":6,"readiness":"available"}},
      {"object_type": "Vehicle", "id": "car-03", "data": {"callsign":"03 号备用车", "seats":6,"readiness":"available"}},
      {"object_type": "Vehicle", "id": "car-05", "data": {"callsign":"05 号接驳车（已分配）", "seats":6,"readiness":"available"}},
      {"object_type": "Vehicle", "id": "car-small", "data": {"callsign":"单座车辆（容量不足）", "seats":1,"readiness":"available"}}
    ]
  }, {
    "id": "golf-hkg-dispatch-demo", "title": "香港接机调度 · Agent Runtime 演练",
    "objects": [
      {"object_type":"TransferLeg","id":"dispatch-time-001","data":{"title":"接机演练 · 调整时间","route":"香港国际机场会合点 → 演练酒店","player_name":"时间演练乘客","assigned_driver":"demo-staff","dispatch_state":"assigned","vehicle_id":"demo-car-time","passengers":2,"service_facts":[{"label":"机场会合","status":"current"},{"label":"登车交接","status":"pending"}]}},
      {"object_type":"TransferLeg","id":"dispatch-vehicle-001","data":{"title":"接机演练 · 故障换车","route":"香港国际机场会合点 → 演练酒店","player_name":"备用车演练乘客","assigned_driver":"demo-other","dispatch_state":"assigned","vehicle_id":"demo-car-fault","passengers":3,"service_facts":[{"label":"机场会合","status":"current"},{"label":"登车交接","status":"pending"}]}},
      {"object_type":"Vehicle","id":"demo-car-time","data":{"callsign":"A01 演练接驳车","seats":6,"readiness":"available"}},
      {"object_type":"Vehicle","id":"demo-car-fault","data":{"callsign":"B01 演练故障车","seats":6,"readiness":"unavailable"}},
      {"object_type":"Vehicle","id":"demo-car-spare","data":{"callsign":"B02 演练备用车","seats":6,"readiness":"available"}}
    ]
  }, {
    "id": "golf-hkg-arrivals-demo",
    "title": "香港球员接待 · 演练活动",
    "objects": [
      {
        "object_type": "Vehicle",
        "id": "arrival-van-1",
        "data": {
          "callsign": "接待 01 · 演练车辆",
          "seats": 6,
          "readiness": "available"
        }
      },
      {
        "object_type": "Vehicle",
        "id": "arrival-van-2",
        "data": {
          "callsign": "接待 02 · 演练车辆",
          "seats": 6,
          "readiness": "available"
        }
      },
      {
        "object_type": "Vehicle",
        "id": "arrival-van-3",
        "data": {
          "callsign": "接待 03 · 演练车辆",
          "seats": 10,
          "readiness": "available"
        }
      }
    ]
  }]
}
